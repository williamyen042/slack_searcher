# ── Mode: choose one ──────────────────────────────────────────────────────────
# Option A: Slack Export (no bot token required)
# Point to the unzipped export folder. Leave blank to use live API instead.
SLACK_EXPORT_PATH=/path/to/your/slack-export
# Your Slack workspace URL — used to generate message links in export mode
# e.g. https://yourworkspace.slack.com
SLACK_WORKSPACE_URL=https://yourworkspace.slack.com

# Option B: Live Slack API
# Leave SLACK_EXPORT_PATH blank and fill these in instead.
SLACK_BOT_TOKEN=xoxb-your-token-here

# Optional: restrict search to specific channel IDs (comma-separated).
# If left blank, the bot will automatically discover and search ALL channels
# it has access to. Use this to limit scope for performance or privacy.
# Example: SLACK_CHANNEL_IDS=C0123456789,C9876543210
SLACK_CHANNEL_IDS=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Required. Used for the dense retrieval path (and the dense half of hybrid).
OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_EMBED_MODEL=text-embedding-3-small   # optional, this is the default

# ── Chunking configuration (optional — defaults shown) ────────────────────────
# Target token size for each chunk sent to the embedding model.
# CHUNK_SIZE_TOKENS=350

# Number of tokens of overlap between adjacent chunks.
# Prevents concepts from being split across chunk boundaries.
# CHUNK_OVERLAP_TOKENS=60

# Hard ceiling for any single chunk — must not exceed the model's token limit.
# MAX_MODEL_TOKENS=512

# ── Index ─────────────────────────────────────────────────────────────────────
# Where the SQLite index lives. Built by `python index.py`, read by the server.
# Delete this file to force a full rebuild.
# INDEX_PATH=./slack_index.db

# Chunks embedded per OpenAI request during indexing (API cap is 2048).
# EMBED_BATCH=256

# How far back before the stored cursor each incremental run re-walks.
# A cursor only advances past NEW timestamps, so without this a reply added to
# an old thread — or an edit to an old message — is never picked up. Re-walked
# messages that haven't changed cost zero embeddings.
# INDEX_LOOKBACK_HOURS=48

# ── Retrieval mode (optional — default: dense) ────────────────────────────────
# dense  — OpenAI embeddings + cosine similarity (original behaviour)
# bm25   — BM25 lexical index only (good for exact tokens: error codes, IDs)
# hybrid — top-100 dense + top-100 BM25, fused with Reciprocal Rank Fusion
# RETRIEVAL_MODE=dense
